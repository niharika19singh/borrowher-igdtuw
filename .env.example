# ==============================================================================
# BORROWHER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or set in Vercel / Cloud Functions environment
# ==============================================================================

# --- Frontend Client Configuration (Vercel & Local Vite) ---
# Note: These values identify the Firebase project to the client SDK and are public.
# Real security is strictly enforced by Firestore & Storage Rules + Backend Functions.
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="borrowher-igdtuw.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="borrowher-igdtuw"
VITE_FIREBASE_STORAGE_BUCKET="borrowher-igdtuw.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Toggle local emulator usage for frontend development
VITE_USE_FIREBASE_EMULATOR="true"
VITE_FIREBASE_AUTH_EMULATOR_URL="http://127.0.0.1:9099"
VITE_FIRESTORE_EMULATOR_HOST="127.0.0.1"
VITE_FIRESTORE_EMULATOR_PORT="8080"
VITE_FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1"
VITE_FIREBASE_STORAGE_EMULATOR_PORT="9199"
VITE_FUNCTIONS_EMULATOR_ORIGIN="http://127.0.0.1:5001"

# --- Backend & Admin CLI Script Configuration ---
# Used by scripts/bootstrap-admin.ts and scripts/seed-*.ts
FIREBASE_PROJECT_ID="borrowher-igdtuw"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"

# For live staging/production scripts only (leave empty when using emulators):
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/serviceAccountKey.json"

# First Administrator Configuration (for bootstrap-admin.ts)
FIRST_ADMIN_EMAIL="admin@igdtuw.ac.in"
FIRST_ADMIN_DISPLAY_NAME="IGDTUW System Administrator"
FIRST_ADMIN_PASSWORD="ChangeMeInProduction123!"
